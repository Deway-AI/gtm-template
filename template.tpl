___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const callInWindow = require('callInWindow');
const copyFromDataLayer = require('copyFromDataLayer');
const copyFromWindow = require('copyFromWindow');
const getType = require('getType');

const scriptUrl = 'https://unpkg.com/@deway-ai/web-sdk@1/dist/loader.umd.js';
const command = data.command;

// Executes the selected Deway.* command. Assumes window.Deway (the loader shell, which
// owns the command queue) exists: commands issued before init() completes are queued by
// the loader and replayed once initialization finishes, so a standalone command tag is
// safe even if this tag fires before an Initialize tag.
const runCommand = () => {
  if (command === 'initialize') {
    callInWindow('Deway.init', { appKey: data.appKey });
    const userId = data.userIdKey ? copyFromDataLayer(data.userIdKey) : null;
    const userProfile = data.userProfileKey ? copyFromDataLayer(data.userProfileKey) : null;
    if (userId && typeof userId === 'string') {
      callInWindow('Deway.identify', userId);
    }
    if (getType(userProfile) === 'object') {
      callInWindow('Deway.setUserProfile', userProfile);
    }
  } else if (command === 'identify') {
    const userId = data.identifyUserIdKey ? copyFromDataLayer(data.identifyUserIdKey) : null;
    if (userId && typeof userId === 'string') {
      callInWindow('Deway.identify', userId);
    }
  } else if (command === 'set_user_profile') {
    const profile = data.setUserProfileKey ? copyFromDataLayer(data.setUserProfileKey) : null;
    if (getType(profile) === 'object') {
      callInWindow('Deway.setUserProfile', profile);
    }
  } else if (command === 'report_event') {
    const params = data.eventParamsKey ? copyFromDataLayer(data.eventParamsKey) : null;
    callInWindow('Deway.reportEvent', data.eventName, getType(params) === 'object' ? params : {});
  } else if (command === 'open_chat') {
    if (data.chatPrompt) {
      callInWindow('Deway.openChat', data.chatPrompt);
    } else {
      callInWindow('Deway.openChat');
    }
  } else if (command === 'show') {
    if (data.appearanceMode) {
      callInWindow('Deway.show', { appearanceMode: data.appearanceMode });
    } else {
      callInWindow('Deway.show');
    }
  } else if (command === 'hide') {
    callInWindow('Deway.hide');
  } else if (command === 'reset_user_locally') {
    callInWindow('Deway.resetUserLocally');
  }
};

// The Initialize command always injects the loader (that is the install action).
// Every other command fires independently: if the loader is already present, call
// straight through; otherwise inject the loader first so the command is queued and
// replayed by the loader once init() runs.
if (command === 'initialize') {
  injectScript(scriptUrl, () => {
    runCommand();
    data.gtmOnSuccess();
  }, data.gtmOnFailure, scriptUrl);
} else if (getType(copyFromWindow('Deway.init')) === 'function') {
  runCommand();
  data.gtmOnSuccess();
} else {
  injectScript(scriptUrl, () => {
    runCommand();
    data.gtmOnSuccess();
  }, data.gtmOnFailure, scriptUrl);
}


